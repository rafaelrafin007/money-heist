{
  "expo": {
    "name": "Money Heist",
    "slug": "money-heist",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "moneyheist",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.rafaelrafin007.moneyheist",
      "supportsTablet": true
    },
    "android": {
      "package": "com.rafaelrafin007.moneyheist",
      "adaptiveIcon": {
        "backgroundColor": "#0B1F2A",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B1F2A",
          "dark": {
            "backgroundColor": "#0B1F2A"
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2d3ffc45-cd87-4330-9112-bdc60d69240f"
      }
    },
    "owner": "rafaelrafin007s-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2d3ffc45-cd87-4330-9112-bdc60d69240f"
    }
  }
}
